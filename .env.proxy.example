# Moon RO — standalone WebSocket proxy (proxy.moon-ro.com)
# ไม่ใช่ .env.production (นั่นของ GRF client บน rom-web)
# Process: node start-ws-proxy.js  ·  PM2 app: moon-ws-proxy
#
# Copy locally before deploy (gitignored — put secrets in .env.proxy.production):
#   cp .env.proxy.example .env.proxy.production
# Local dev (start-ws-proxy reads .env by default):
#   cp .env.proxy.example .env
#
# Deploy: ./deploy/deploy-proxy.sh  (ENV_FILE=.env.proxy.production → VPS .env)

NODE_ENV=production
HOST=127.0.0.1
WS_PROXY_PORT=5999

WS_ALLOWED_TARGETS=43.228.86.182:6900,43.228.86.182:6121,43.228.86.182:5121
WS_ALLOWED_ORIGINS=https://moon-ro.com,https://www.moon-ro.com,127.0.0.1,localhost,robrowser.test

WS_REWRITE_LOGIN_PACKET=true
WS_LOGIN_PORT=6900
#WS_CHAR_PORT=6121
#WS_MAP_PORT=5121

# ─── Cloudflare Turnstile (WSS จาก /play) ───────────────────────────
# Secret = ค่าเดียวกับ rom-frontend TURNSTILE_SECRET_KEY (ไม่ใช่ site key)
# ใส่ใน .env.proxy.production ก่อน deploy — ถ้าว่าง deploy จะพยายามคงค่าเดิมบน VPS
TURNSTILE_SECRET_KEY=

WS_TURNSTILE_ENFORCE=true
WS_TURNSTILE_LOGIN_ONLY=true
#WS_TURNSTILE_VERIFY_TIMEOUT_MS=8000

# Client Hints — block desktop ?0 on login WSS (#2–4); REQUIRE=1 blocks missing ch-mobile (official client sends ?1)
WS_CLIENT_HINTS_ENFORCE=true
WS_CLIENT_HINTS_LOGIN_ONLY=true
WS_CLIENT_HINTS_REQUIRE=true

# UA gate (#5 + emulator) — 403 ก่อน Turnstile บน login WSS
WS_UA_EMULATOR_BLOCK=true
WS_UA_DESKTOP_BLOCK=true
WS_UA_GATE_LOGIN_ONLY=true

# Rate limit login WSS upgrades per client IP (#9)
WS_RATE_LIMIT_LOGIN=true
WS_RATE_LIMIT_LOGIN_ONLY=true
WS_RATE_LIMIT_LOGIN_MAX=40
WS_RATE_LIMIT_LOGIN_WINDOW_MS=60000

# Site key → ตอน build ror-browser เท่านั้น (PLAY_TURNSTILE_SITE_KEY) — ไม่ใส่ในไฟล์ proxy

# Smoke: WS_TURNSTILE_ENFORCE=false จนกว่า deploy-play มี Turnstile แล้ว

# ─── Login audit (IPv4 + Game ID on SSO login — no password) ─────────
WS_LOGIN_AUDIT=1
WS_LOGIN_AUDIT_PATH=./logs/ws-login-audit.jsonl
#WS_LOGIN_AUDIT_RETENTION_DAYS=90

# ─── Metrics (optional) ──────────────────────────────────────────────
#WS_METRICS_INTERVAL_MS=60000
#WS_METRICS_HISTORY_FILE=./logs/ws-metrics.jsonl
#WS_METRICS_PEAK_FILE=./logs/ws-metrics-peak.json
