PORT=3338
CLIENT_PUBLIC_URL=http://127.0.0.1:8000
# Comma-separated browser Origins allowed to fetch assets (play client, etc.)
#CORS_ORIGINS=https://moon-ro.com,https://www.moon-ro.com,http://robrowser.test,http://robrowser.test:8080
NODE_ENV=development

# Cache settings
CACHE_MAX_FILES=5000
CACHE_MAX_MEMORY_MB=1024

# Warm-up: pre-loads frequently used assets into cache on startup
# CACHE_WARM_UP=true  - Enable cache warm-up
# CACHE_WARM_UP_LIMIT=500  - Max files to pre-load
CACHE_WARM_UP=true
CACHE_WARM_UP_LIMIT=500

# Unified server settings
# ENABLE_WSPROXY=true  - Embed WS proxy in the asset server (legacy / all-in-one)
# Prefer running `node start-ws-proxy.js` (or PM2 app moon-ws-proxy) separately in production
# so gameplay traffic does not share the event loop with GRF asset I/O.
# ENABLE_STATIC_SERVE=true - Serves roBrowserLegacy static files (replaces live-server)
ENABLE_WSPROXY=true
ENABLE_STATIC_SERVE=true
ROBROWSER_PATH=../roBrowserLegacy

# Standalone WS proxy (start-ws-proxy.js / PM2 moon-ws-proxy)
#WS_PROXY_PORT=5999

# OBT metrics (concurrent + max players via map-port tunnels; mobile from User-Agent)
# Snapshot every N ms → jsonl history; max all-time/daily persisted separately
#WS_METRICS_INTERVAL_MS=60000
#WS_METRICS_HISTORY_FILE=./logs/ws-metrics.jsonl
#WS_METRICS_PEAK_FILE=./logs/ws-metrics-peak.json
#WS_CHAR_PORT=6121
#WS_MAP_PORT=5121

# WS proxy target allowlist (only used when ENABLE_WSPROXY=true)
# Comma-separated "host:port" pairs the proxy is permitted to forward to.
# Defaults to localhost only (127.0.0.1:6900, 6121, 5121) when not set.
# Override for non-host-network deployments where rAthena is on a different host:
#   WS_ALLOWED_TARGETS=10.0.0.5:6900,10.0.0.5:6121,10.0.0.5:5121
# Docker Desktop (macOS/Windows):
#   WS_ALLOWED_TARGETS=host.docker.internal:6900,host.docker.internal:6121,host.docker.internal:5121
#WS_ALLOWED_TARGETS=

# WS proxy Origin allowlist (browser Origin header must match).
# Comma-separated full origins (https://moon-ro.com) or hostnames (127.0.0.1, robrowser.test).
# Default: https://moon-ro.com, https://www.moon-ro.com, 127.0.0.1, localhost, robrowser.test
#WS_ALLOWED_ORIGINS=https://moon-ro.com,127.0.0.1,robrowser.test

# Rewrite roBrowser SSO login packet 0x0888 → rAthena 0x0825 on the login port only.
# (Same packet body; only the header ID differs. Map/char ports are never rewritten.)
# Set to false to disable. Default: enabled when ENABLE_WSPROXY=true.
#WS_REWRITE_LOGIN_PACKET=true
#WS_LOGIN_PORT=6900

# ESRGAN upscaling plugin (@chicowall/robrowser-esrgan)
# Serves AI-upscaled textures/sprites from a pre-built disk cache.
# When enabled, asset requests are intercepted and served from the cache
# before falling through to GRF lookup. Zero overhead when disabled.
# Install: npm install @chicowall/robrowser-esrgan
# Populate cache: python tools/esrgan_pipeline/orchestrate.py
#ESRGAN_ENABLED=true
#ESRGAN_CACHE_DIR=./upscaled_cache

# External data override directory
# Path to a directory with loose data files (msgstringtable.txt, etc.)
# that are NOT inside the GRF. The server checks this path as a fallback
# after local data/ and before GRF lookup.
# Typically points to the RO client's data/ folder.
#DATA_OVERRIDE_PATH=../cliente_exe/data
