# Copy to deploy/proxy.env — WS proxy on rom-server
# cp deploy/proxy.env.example deploy/proxy.env

DEPLOY_ROLE=proxy
PM2_APP=moon-ws-proxy

VPS_USER=root
VPS_HOST=rom-server

PROXY_DOMAIN=proxy.moon-ro.com
REMOTE_DOMAINS=proxy.moon-ro.com
CERT_NAME=proxy.moon-ro.com

CERTBOT_EMAIL=admin@moon-ro.com
CERTBOT_WEBROOT=/var/www/certbot
SSL_CERT_PATH=/etc/letsencrypt/live/proxy.moon-ro.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/proxy.moon-ro.com/privkey.pem

REMOTE_ROOT=/var/www/moon-ws-proxy
PROXY_PORT=5999

ENV_FILE=.env.proxy.production
