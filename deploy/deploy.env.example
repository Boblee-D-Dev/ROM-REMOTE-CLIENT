# Copy to deploy/deploy.env and edit for your VPS.
# cp deploy/deploy.env.example deploy/deploy.env

# --- SSH target ---
VPS_USER=root
VPS_HOST=rom-web

# --- Domains (certbot SANs — both use same cert on production) ---
CLIENT_DOMAIN=client.moon-ro.com
PROXY_DOMAIN=proxy.moon-ro.com
REMOTE_DOMAINS="client.moon-ro.com proxy.moon-ro.com"
CERT_NAME=client.moon-ro.com

# --- SSL: Let's Encrypt via certbot ---
CERTBOT_EMAIL=admin@moon-ro.com
CERTBOT_WEBROOT=/var/www/certbot
SSL_CERT_PATH=/etc/letsencrypt/live/client.moon-ro.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/client.moon-ro.com/privkey.pem

# --- App path on VPS ---
REMOTE_ROOT=/var/www/moon-remote-client

# Upstream ports (nginx → Node)
CLIENT_PORT=3338
PROXY_PORT=5999

# Local env file synced as .env on VPS (create from .env.example)
ENV_FILE=.env.production

# --- Deploy toggles ---
# SKIP_NGINX=0
